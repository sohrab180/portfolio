# Public site URL — used for SEO metadata (Open Graph, canonical, sitemap.xml, robots.txt).
NEXT_PUBLIC_SITE_URL=https://sohrabaliansari.com

# Base URL of the portfolio chatbot API (the "portfolio" module in the
# D:\Tracking-App\backend repo, mounted at /api/portfolio — see
# src/portfolio/portfolio.app.js there). Locally it runs on that backend's
# PORT=4000; in production it's deployed at https://cardbanao.com. Make sure
# CORS_ORIGINS on the backend includes this site's deployed origin.
NEXT_PUBLIC_CHATBOT_API_URL=https://cardbanao.com/api/portfolio
